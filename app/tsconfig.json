{
  "compilerOptions": {
    "target": "es2016", // 1. Updated from 'es5' to allow compilation of modern features
    "lib": [
      "dom", 
      "dom.iterable", 
      "es2016"          // 2. Updated from 'es6' to include Array.prototype.includes
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "my-app/src/components",
    "my-app/src/context",
    "my-app/src/routes",
    "my-app/reportWebVitals.js",
    "my-app/setupTests.js"
  ]
}